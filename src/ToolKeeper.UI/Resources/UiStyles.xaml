<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="MenuStyles.xaml" />
  <ResourceDictionary Source="SidebarScrollStyles.xaml" />
 </ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="WindowBackground" Color="#D9DEE4" />
 <SolidColorBrush x:Key="SurfaceBrush" Color="#E8EBEF" />
 <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
 <SolidColorBrush x:Key="MutedBrush" Color="#656D76" />
 <SolidColorBrush x:Key="LineBrush" Color="#BEC6CF" />
 <SolidColorBrush x:Key="HoverBrush" Color="#CDD4DD" />
 <SolidColorBrush x:Key="AccentBrush" Color="#0969DA" />
 <Style x:Key="UiButtonStyle" TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="Padding" Value="10,7" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="1" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource UiButtonStyle}" />
 <Style TargetType="TextBox">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  <Setter Property="Padding" Value="7,5" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
 </Style>
</ResourceDictionary>
