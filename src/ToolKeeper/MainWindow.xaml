<ui:AppWindow x:Class="ToolKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ToolKeeper.UI;assembly=ToolKeeper.UI"
        MainName="ToolKeeper" SubName="工具番"
        Width="820" Height="620" MinWidth="720" MinHeight="500">
    <ui:AppWindow.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/ToolKeeper;component/Modules/UtilityStyles.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </ui:AppWindow.Resources>
    <ui:AppWindow.Workspace>
        <Border x:Name="ToolList" Style="{StaticResource DropCard}" Padding="20,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource ToolKeeper.ToolsTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource ToolKeeper.ToolsCatalog}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="PlatformStatus" DockPanel.Dock="Top" Visibility="Collapsed" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Products">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ActionText}" IsEnabled="{Binding CanActivate}" Click="ProductActivationClick" MinWidth="100" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ActionHelp}" AutomationProperties.Name="{Binding ActionName}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </ui:AppWindow.Workspace>
</ui:AppWindow>
