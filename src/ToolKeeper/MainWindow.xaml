<ui:AppWindow x:Class="ToolKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ToolKeeper.UI;assembly=ToolKeeper.UI"
        MainName="ToolKeeper" SubName="工具番"
        Width="1100" Height="850" MinWidth="860" MinHeight="740">
    <ui:AppWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource UiButtonStyle}">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft JhengHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarVerticalScrollBarStyle}" />
        <Style x:Key="HashValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.HelpText" Value="{DynamicResource ToolKeeper.HashHelp}" />
        </Style>
        <Style x:Key="DropCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </ui:AppWindow.Resources>
    <ui:AppWindow.HeaderActions>
        <Border VerticalAlignment="Center" Background="{DynamicResource HoverBrush}" CornerRadius="12" Padding="12,6">
            <TextBlock Text="{DynamicResource ToolKeeper.Badge}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
        </Border>
    </ui:AppWindow.HeaderActions>
    <ui:AppWindow.Workspace>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="340" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="HashDropZone" Grid.Column="0" Style="{StaticResource DropCard}" AllowDrop="True"
                    PreviewDragEnter="HashDragOver" PreviewDragOver="HashDragOver" PreviewDragLeave="DropZoneDragLeave" PreviewDrop="HashDrop">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="01" Foreground="{DynamicResource MutedBrush}" FontSize="24" />
                            <TextBlock Text="{DynamicResource ToolKeeper.HashTitle}" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource ToolKeeper.HashDropHint}" Margin="0,8,0,4" />
                        <TextBlock Text="MD5 · SHA-1 · SHA-256" Style="{StaticResource Muted}" />
                        <DockPanel Margin="0,14,0,10">
                            <Button x:Name="ChooseHashButton" Content="{DynamicResource ToolKeeper.ChooseFile}" Click="ChooseHashClick" DockPanel.Dock="Left" />
                            <Button x:Name="CancelHashButton" Content="{DynamicResource ToolKeeper.Cancel}" Click="CancelHashClick" DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed" IsEnabled="False" />
                            <TextBlock x:Name="HashFileName" Text="{DynamicResource ToolKeeper.OneFile}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="HashProgress" Minimum="0" Maximum="1" Height="3" Value="0" BorderThickness="0" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="MD5" FontSize="12" VerticalAlignment="Center" />
                            <TextBox x:Name="Md5Output" Grid.Column="1" Style="{StaticResource HashValue}" MinHeight="30" AutomationProperties.Name="MD5" />
                            <TextBlock Grid.Row="1" Text="SHA-1" FontSize="12" VerticalAlignment="Center" />
                            <TextBox x:Name="Sha1Output" Grid.Row="1" Grid.Column="1" Style="{StaticResource HashValue}" MinHeight="30" Margin="0,6,0,0" AutomationProperties.Name="SHA-1" />
                            <TextBlock Grid.Row="2" Text="SHA-256" FontSize="12" VerticalAlignment="Center" />
                            <TextBox x:Name="Sha256Output" Grid.Row="2" Grid.Column="1" Style="{StaticResource HashValue}" MinHeight="30" Margin="0,6,0,0" AutomationProperties.Name="SHA-256" />
                        </Grid>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="CopyHashesButton" DockPanel.Dock="Right" Content="{DynamicResource ToolKeeper.CopyAll}" Click="CopyHashesClick" IsEnabled="False" Padding="10,5" MinHeight="30" />
                            <TextBlock Text="{DynamicResource ToolKeeper.CompareHint}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        </DockPanel>
                        <TextBox x:Name="ExpectedHash" Margin="0,7,0,0" MinHeight="34" TextChanged="ExpectedHashChanged" AutomationProperties.Name="{DynamicResource ToolKeeper.ExpectedHash}" />
                        <TextBlock x:Name="HashComparison" Text="{DynamicResource ToolKeeper.CompareEmpty}" FontSize="12" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock x:Name="HashStatus" Text="{DynamicResource ToolKeeper.NoFile}" Style="{StaticResource Muted}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="IconDropZone" Grid.Column="2" Style="{StaticResource DropCard}" AllowDrop="True"
                    PreviewDragEnter="IconDragOver" PreviewDragOver="IconDragOver" PreviewDragLeave="DropZoneDragLeave" PreviewDrop="IconDrop">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="60" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="02" Foreground="{DynamicResource MutedBrush}" FontSize="24" />
                            <TextBlock Text="{DynamicResource ToolKeeper.IconTitle}" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource ToolKeeper.IconDropHint}" Margin="0,8,0,4" />
                        <TextBlock Text="{DynamicResource ToolKeeper.IconFormats}" Style="{StaticResource Muted}" />
                        <DockPanel Margin="0,14,0,12">
                            <Button x:Name="ChooseImagesButton" Content="{DynamicResource ToolKeeper.ChooseImages}" Click="ChooseImagesClick" DockPanel.Dock="Left" />
                            <Button x:Name="CancelIconsButton" Content="{DynamicResource ToolKeeper.Cancel}" Click="CancelIconsClick" DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed" IsEnabled="False" />
                            <TextBlock Text="{DynamicResource ToolKeeper.OriginalFolder}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Border x:Name="IconEmptyState" Background="{DynamicResource WindowBackground}" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="ICO" FontSize="30" FontWeight="Light" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource ToolKeeper.IconEmpty}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="IconResults" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{DynamicResource ToolKeeper.IconResults}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" Background="{DynamicResource WindowBackground}" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SourcePath}" />
                                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding OutputPath}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding OutputPath}" />
                                            <Button Content="{DynamicResource ToolKeeper.ShowInFolder}" Click="ShowIconClick" HorizontalAlignment="Left" Margin="0,7,0,0" Padding="9,4" MinHeight="27" FontSize="12">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Success}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{DynamicResource ToolKeeper.IconSizes}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{DynamicResource ToolKeeper.IconNames}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <TextBlock x:Name="IconStatus" Text="{DynamicResource ToolKeeper.NoImages}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="ToolList" Grid.Row="1" Style="{StaticResource DropCard}" Margin="0,16,0,0" Padding="20,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource ToolKeeper.ToolsTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource ToolKeeper.ToolsPreview}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="Products">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource ToolKeeper.OpenGet}" IsEnabled="False" MinWidth="100" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" ToolTip="{DynamicResource ToolKeeper.ComingLater}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="{DynamicResource ToolKeeper.Privacy}" Style="{StaticResource Muted}" Margin="2,12,0,0" FontSize="11" />
    </Grid>
    </ui:AppWindow.Workspace>
</ui:AppWindow>

