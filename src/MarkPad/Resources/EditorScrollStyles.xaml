<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Scoped to AvalonEdit. Keep its ScrollViewer and IScrollInfo wiring intact. -->
 <Style x:Key="EditorScrollPageButtonStyle" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="IsTabStop" Value="False" />
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="EditorScrollArrowButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource EditorScrollPageButtonStyle}">
  <Setter Property="Foreground" Value="{DynamicResource EditorScrollThumbBrush}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="RepeatButton">
     <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource EditorScrollHoverBrush}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource EditorScrollHoverBrush}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="EditorScrollThumbStyle" TargetType="Thumb">
  <Setter Property="MinHeight" Value="24" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="IsTabStop" Value="False" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border Background="Transparent">
      <Border x:Name="ThumbBody" Background="{DynamicResource EditorScrollThumbBrush}" CornerRadius="5" Margin="3,1" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource EditorScrollHoverBrush}" /></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource EditorScrollHoverBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbBody" Property="Opacity" Value="0.4" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <ControlTemplate x:Key="EditorVerticalScrollBarTemplate" TargetType="ScrollBar">
  <Grid Background="{DynamicResource EditorScrollTrackBrush}" SnapsToDevicePixels="True">
   <Grid.RowDefinitions><RowDefinition Height="15" /><RowDefinition Height="*" /><RowDefinition Height="15" /></Grid.RowDefinitions>
   <RepeatButton Style="{StaticResource EditorScrollArrowButtonStyle}" Command="{x:Static ScrollBar.LineUpCommand}"
                 CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
    <Path Data="M 0,4 L 4,0 L 8,4 Z" Width="8" Height="4" Stretch="Fill"
          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
   </RepeatButton>
   <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True"
          Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
          Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
    <Track.DecreaseRepeatButton>
     <RepeatButton Style="{StaticResource EditorScrollPageButtonStyle}" Command="{x:Static ScrollBar.PageUpCommand}"
                   CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
    </Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource EditorScrollThumbStyle}" /></Track.Thumb>
    <Track.IncreaseRepeatButton>
     <RepeatButton Style="{StaticResource EditorScrollPageButtonStyle}" Command="{x:Static ScrollBar.PageDownCommand}"
                   CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
    </Track.IncreaseRepeatButton>
   </Track>
   <RepeatButton Grid.Row="2" Style="{StaticResource EditorScrollArrowButtonStyle}" Command="{x:Static ScrollBar.LineDownCommand}"
                 CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
    <Path Data="M 0,0 L 8,0 L 4,4 Z" Width="8" Height="4" Stretch="Fill"
          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
   </RepeatButton>
  </Grid>
 </ControlTemplate>
 <Style TargetType="ScrollBar">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="IsTabStop" Value="False" />
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Vertical">
    <Setter Property="Width" Value="15" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Template" Value="{StaticResource EditorVerticalScrollBarTemplate}" />
   </Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
