<Window x:Class="MarkPad.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:theming="clr-namespace:MarkPad.Theming"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="汗青 - Markdown Writer" Icon="Assets/MarkPad.ico" Width="900" Height="720" MinWidth="640" MinHeight="420"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource ChromeBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13" AllowDrop="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="4" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ToolKeeper.UI;component/Resources/UiStyles.xaml" />
    <ResourceDictionary Source="Resources/ChromeTextStyles.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <!-- Only the custom title bar needs caption-area button hit testing. -->
   <Style TargetType="Button" BasedOn="{StaticResource UiButtonStyle}">
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="ContentTemplateSelector" Value="{StaticResource ChromeButtonTextSelector}" />
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
  <Grid x:Name="RootGrid">
   <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Border x:Name="TitleBar" Panel.ZIndex="30" Background="{DynamicResource ChromeTitleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrandColumn" Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
      <Image Source="Assets/MarkPad.ico" Width="18" Height="18" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
      <theming:ChromeTextShadow><TextBlock x:Name="WindowTitleText" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" VerticalAlignment="Center" /></theming:ChromeTextShadow>
     </StackPanel>
     <Grid x:Name="TabsArea" Grid.Column="1" ClipToBounds="True" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel x:Name="TabsPanel" Orientation="Horizontal" /></Grid>
     <Button x:Name="OverflowButton" Grid.Column="2" Content="⌄" Padding="4" ToolTip="Documents" />
     <UniformGrid Grid.Column="3" Rows="1">
      <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Padding="0" ToolTip="Minimize" />
      <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Padding="0" ToolTip="Maximize" />
      <Button x:Name="WindowCloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Padding="0" ToolTip="Close" />
     </UniformGrid>
     <Border x:Name="InkTitleStroke" Visibility="Collapsed" Height="2" Width="78" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13,0,0,0" IsHitTestVisible="False">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00456B61" Offset="0" /><GradientStop Color="#99456B61" Offset="0.22" /><GradientStop Color="#40456B61" Offset="0.85" /><GradientStop Color="#00456B61" Offset="1" /></LinearGradientBrush></Border.Background>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border x:Name="ContentFrame" Grid.Column="1" Margin="12" CornerRadius="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PaperBackgroundBrush}">
     <Grid ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border x:Name="EditorToolbarHost" Visibility="Collapsed" Background="{DynamicResource ChromeToolbarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4,2,4" />
      <Grid x:Name="DocumentHost" Grid.Row="1" />
      <Grid x:Name="EmptyState" Grid.Row="1" Background="{DynamicResource PaperBackgroundBrush}">
       <Viewbox x:Name="InkLandscape" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Stretch="UniformToFill" Height="170" Opacity="0.2" IsHitTestVisible="False" ClipToBounds="True">
        <Canvas Width="640" Height="170">
         <Path Data="M0,138 C60,110 78,142 127,103 C168,70 178,80 214,47 C238,29 252,75 278,84 C323,100 345,42 371,56 C407,73 426,116 464,94 C491,78 508,95 546,120 C579,129 603,116 640,133 L640,170 L0,170 Z">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#737F73" Offset="0" /><GradientStop Color="#00737F73" Offset="1" /></LinearGradientBrush></Path.Fill>
         </Path>
         <Path Data="M0,154 C52,139 63,111 100,129 C126,143 156,93 188,108 C217,128 225,103 249,117 C276,137 315,141 346,124 C389,91 409,109 436,123 C474,148 507,111 544,142 C589,148 609,130 640,150 L640,170 L0,170 Z">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4F6258" Offset="0" /><GradientStop Color="#004F6258" Offset="1" /></LinearGradientBrush></Path.Fill>
         </Path>
         <Path Data="M376,150 C420,147 480,151 522,149 M112,156 C147,153 206,158 259,155" Stroke="#748578" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
       </Viewbox>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Width="56" Height="64" Margin="0,0,0,20"><TextBlock x:Name="EmptyMonogram" Text="M↓" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <theming:ChromeTextShadow><TextBlock x:Name="EmptyLabel" Text="Drop or open Markdown" FontSize="{DynamicResource UiHeadingFontSize}" HorizontalAlignment="Center" TextWrapping="Wrap" /></theming:ChromeTextShadow>
        <Button x:Name="EmptyOpenButton" Content="Open a document  ·  Ctrl+O" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0" />
       </StackPanel>
      </Grid>
      <Border x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed" Width="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Panel.ZIndex="10">
       <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" /></Border.Effect>
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="30" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
         <TextBox x:Name="SearchBox" MinWidth="100" />
         <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" Padding="4" />
         <Button x:Name="CaseButton" Grid.Column="2" Content="Aa" Padding="4" />
         <Button x:Name="CloseSearchButton" Grid.Column="3" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="4" />
        </Grid>
        <DockPanel Margin="0,5,0,0">
         <Button x:Name="ExpandReplaceButton" DockPanel.Dock="Left" Content="Replace" Padding="5,3" />
         <Button x:Name="NextSearchButton" DockPanel.Dock="Right" Content="↓" Padding="8,3" />
         <Button x:Name="PreviousSearchButton" DockPanel.Dock="Right" Content="↑" Padding="8,3" />
         <TextBlock x:Name="SearchCountLabel" Text="0 / 0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0" />
        </DockPanel>
        <StackPanel x:Name="ReplacePanel" Visibility="Collapsed" Margin="0,8,0,0">
         <TextBox x:Name="ReplaceBox" />
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
          <Button x:Name="ReplaceButton" Content="Replace" Padding="8,4" />
          <Button x:Name="ReplaceAllButton" Content="Replace all" Padding="8,4" />
         </StackPanel>
        </StackPanel>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <Border x:Name="Rail" Width="44" HorizontalAlignment="Left" Background="{DynamicResource ChromeRailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Panel.ZIndex="20">
     <DockPanel>
      <Button x:Name="RailToggleButton" DockPanel.Dock="Top" Height="32" Margin="3,4" Padding="4,0" HorizontalContentAlignment="Left" />
      <StackPanel DockPanel.Dock="Bottom" Margin="4,8">
       <TextBlock x:Name="EncodingLabel" Text="UTF-8" FontSize="{DynamicResource UiSmallFontSize}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
       <TextBlock x:Name="CaretLabel" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer x:Name="ActionScrollViewer" Style="{StaticResource SidebarScrollViewerStyle}" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ActionPanel" Margin="3,0" /></ScrollViewer>
     </DockPanel>
    </Border>
   </Grid>
   <Border x:Name="StatusToast" Grid.RowSpan="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,64,20,0" Padding="14,9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Panel.ZIndex="40"><TextBlock x:Name="StatusLabel" TextWrapping="Wrap" MaxWidth="520" /></Border>
   <Border x:Name="TopReveal" Grid.RowSpan="2" Height="6" Background="Transparent" VerticalAlignment="Top" Panel.ZIndex="50" Visibility="Collapsed" />
  </Grid>
 </Border>
</Window>
