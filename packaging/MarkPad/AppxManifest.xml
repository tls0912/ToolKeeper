    <PublisherDisplayName />
    <Description>A small, offline Markdown reader and editor.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-TW" />
